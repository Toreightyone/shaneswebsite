---

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Layout from '../layouts/BlogPost.astro';

---

<!doctype html>
<html lang="en">

<head>
<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
<Header />

<p id="station">This is where the station name goes</p>
<p id="station_time">This is where the rest of it goes</p>

<script>
for (let a = 0; a <= 5; a++) {
Line2stops.forEach((element, index) => {
let params = new URLSearchParams({
  key: "ad3c8199",
  url: "https://www.ttc.ca/ttcapi/routedetail//getstopdetails?stop=" + element,
});
fetch("https://corsproxy.io/?" + params)
  .then(async (response) => {
    if (!response.ok) throw new Error('HTTP ' + response.status + ': ' + await response.text()).then();
    const contentType = response.headers.get('content-type') || '';
    return contentType.includes('json') ? response.json() : response.text();
  })
.then((data) => {
  setTimeout(() => {
    document.getElementById('station').innerHTML = data.stopName;
    Line2ebtime[index] = data.nextTrains[0].arrivalTimes[0].nextArrival;
    document.getElementById('station_time').innerHTML = Line2ebtime.toString();
  }, 1000);
  })
.catch((error) => {
    document.getElementById('station').innerHTML = error.toString();
  });
});
};

</script>
<Footer />
</body>
</html>
