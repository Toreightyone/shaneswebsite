---

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Layout from '../layouts/BlogPost.astro';

---

<!doctype html>
<html lang="en">

<head>
<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
</head>
<body>
<Header />

<p id="station">This is where the station name goes</p>
<p id="station_time">This is where the rest of it goesa</p>

<script>
let Kipling = 0;
let Islington = 0;
let Royal_York = 0;
let Old_Mill = 0;
let Jane = 0;
let Runnymede = 0;
let High_Park = 0;
let Keele = 0;
let Dundas_West = 0;
let Lansdowne = 0;
let Dufferin = 0;
let Ossington = 0;
let Christie = 0;
let Bathurst = 0;
let SpadinaL2 = 0;
let StGeorgeL2 = 0;
let Bay = 0;
let BloorYongeL2 = 0;
let Sherbourne = 0;
let Castle_Frank = 0;
let Broadview = 0;
let Chester = 0;
let Pape = 0;
let Donlands = 0;
let Greenwood = 0;
let Coxwell = 0;
let Woodbine = 0;
let Main_Street = 0;
let Victoria_Park = 0;
let Warden = 0;
let KennedyL2 = 0;

const params = new URLSearchParams({
  key: "ad3c8199",
  url: "https://www.ttc.ca/ttcapi/routedetail//getstopdetails?stop=9445",
});
fetch("https://corsproxy.io/?" + params)
  .then(async (response) => {
    if (!response.ok) throw new Error('HTTP ' + response.status + ': ' + await response.text());
    const contentType = response.headers.get('content-type') || '';
    return contentType.includes('json') ? response.json() : response.text();
  })
.then((data) =>
    document.getElementById('station').innerHTML = data.stopName,
    document.getElementById('station_time').innerHTML = data.nextTrains[0].line + ' ' + data.nextTrains[0].directionText + ' ' + data.nextTrains[0].arrivalTimes[0].nextArrival,
  )
.catch((error) =>
    document.getElementById('station').innerHTML = error.toString(),
  );
</script>

<Footer />
</body>
</html>
