---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Layout from '../layouts/BlogPost.astro';

---

<!doctype html>
<html lang="en">

<style>
.mainimage {
  height: 60vh;
  background-position: center;
  background-image: url("/main-image-skyline.jpg");
  background-size: cover;
}

div.path1 {
	display: grid;
  	grid-template-columns: 32% 3% 32% 1% 32%;
}

div.path2 {
	display: grid;
  	grid-template-columns: 23.25% 2.33% 23.25% 2.33% 23.25% 2.33% 23.25%;
}

div.path3 {
	display: grid;
  	grid-template-columns: 49% 2% 49%;
}

</style>

	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
			<div class="mainimage"></div>
		<main>
			<h2 style="text-align: center;">PATH Map Redesign</h2>
			<p style="margin: 4px; text-align: center;"> After one too many times helping lost tourists and residents alike navigate the labyrinth that is the PATH, I decided to redesign the current spaghetti-like map into one closer resembling a subway map, with inspiration from the Tokyo Metro, which numbers stations.<p>
			<div class="path1">
				<div style="background-color:#FFFFFF;">
					<h5> Current: </h5>
					<img src="/94dd-PATH-Basemap-2023-12-FINAL_page-0001.jpg">
				</div>
				<div style="background-color:#FFFFFF; width:2px;">
				</div>
				<div style="background-color:#FFFFFF;">
					<h5> My Version: </h5>
					<img src="/Shane Gates - Map.jpg">
				</div>
				<div style="background-color:#FFFFFF; width:2px;">
				</div>
				<div style="background-color:#FFFFFF;">
					<h5>&#8203;&#8203;</h5>
					<img src="/Shane Gates - Directory.jpg">
				</div>
			</div>
			<br>
			<div class="path2">
				<div style="background-color:#FFFFFF;">
					<img src="/Shane Gates - Pr1-2.jpg">
				</div>
				<div style="background-color:#FFFFFF; width:2px;">
				</div>
				<div style="background-color:#FFFFFF;">
					<img src="/Shane Gates - R17P10G9.jpg">
				</div>
				<div style="background-color:#FFFFFF; width:2px;">
				</div>
				<div style="background-color:#FFFFFF;">
					<img src="/Shane Gates - R6P6.jpg">
				</div>
				<div style="background-color:#FFFFFF; width:2px;">
				</div>
				<div style="background-color:#FFFFFF;">
					<img src="/Shane Gates - R7P7B14.jpg">
				</div>
			</div>
			<br>
			<div class="path3">
				<div style="background-color:#FFFFFF;">
					<h5> BlogTO: </h5>
					<a href="/blogtopath"><img src="/Website BlogTO.jpg"></a>
				</div>
				<div style="background-color:#FFFFFF; width:2px;">
				</div>
				<div style="background-color:#FFFFFF;">
					<h5> CBC Metro Morning: </h5>
					<audio controls>
						<source src="/PATH int.wav" type="audio/wav">
						Your browser does not support audio playback.
					</audio>
				</div>
			</div>
			<br>
			<br>
			<h2 style="text-align: center;">Modal Equity Advocacy</h2>
			<div style="left: 0; width: 100%; height: 0; position: relative; padding-bottom: 56.25%;">
				<iframe src="https://www.youtube.com/embed/fFhPCXKpd18?rel=0&start=22364&end=22576" style="top: 0; left: 0; width: 100%; height: 100%; position: absolute; border: 0;" allowfullscreen scrolling="no" allow="accelerometer *; clipboard-write *; encrypted-media *; gyroscope *; picture-in-picture *; web-share *;" referrerpolicy="strict-origin"></iframe>
			</div>
			<p style="margin: 4px; text-align: center;"> Spoke to the Toronto East York Community Council in favour of the Church Street Pedestrianisation project. An area where residents, tourists, and those attempting to support local businesses have to fight for sidewalk space while the vast minority of road users in private vehicles get the majority of the space.</p>
		</main>
		<Footer />
	</body>
</html>
