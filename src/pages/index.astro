---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Layout from '../layouts/BlogPost.astro';

---

<!doctype html>
<html lang="en">

<style>
.mainimage {
  height: 60vh;
  background-position: center;
  background-image: url("/main-image-skyline.jpg");
  background-size: cover;
}

div.path {
	display: grid;
  	grid-template-columns: 30% 1.5% 33% 1.5% 33%;
}

</style>

	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
			<div class="mainimage"></div>
		<main>
			<h2>PATH Map Redesign</h2>
			<div class="path">
				<div style="background-color:#E5E3FF;">
					<p style="margin: 4px; text-align: center;"> After one too many times helping lost tourists and residents alike navigate the labyrinth that is the PATH, I decided to redesign the current spaghetti-like map into one closer resembling a subway map, with inspiration from the Tokyo Metro, which numbers stations.<p>
				</div>
				<div style="background-color:#FFFFFF; width:2px">
				</div>
				<div style="background-color:#000000;">
					<img src="/Shane Gates - Map.jpg">
				</div>
				<div style="background-color:#FFFFFF; width:2px">
				</div>
				<div style="background-color:#000000;">
					<img src="/Shane Gates - Directory.jpg">
				</div>
			</div>					
		</main>
		<Footer />
	</body>
</html>
